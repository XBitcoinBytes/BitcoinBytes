# BitcoinBytes environment variables (names only; never commit values).
# Nothing is required: the app runs on public exchange data with no keys.

# Set by the host (Railway/Render/Fly). Defaults to 5000.
PORT=
# Set to "production" by the start script / Dockerfile.
NODE_ENV=

# Optional: raises CoinGecko rate limits (fewer 429s on chart/market data).
COINGECKO_API_KEY=
# Optional: Google Analytics measurement ID (build-time; requires CSP update for GA hosts).
VITE_GA_MEASUREMENT_ID=

# Optional: comma-separated extra origins allowed to call /api from a browser.
ALLOWED_ORIGIN=
# Optional: >= 32 random chars; enables admin-only maintenance POST endpoints.
ADMIN_TOKEN=
# Optional: "true" to enable the legacy /ws price feed (the current client does not use it).
ENABLE_WEBSOCKET=
# Optional: Redis cache (falls back to in-memory).
REDIS_URL=
# Optional: header holding the client IP when your edge overwrites it (default x-real-ip on Railway; 'none' to use req.ip)
CLIENT_IP_HEADER=
