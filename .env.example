# Database Configuration
DATABASE_URL=postgresql://username:password@hostname:port/database?sslmode=require
PGHOST=localhost
PGPORT=5432
PGDATABASE=bitcoin_bytes
PGUSER=postgres
PGPASSWORD=password

# OpenAI Integration (Required for AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# SendGrid Email Service (Required for price alerts)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Google Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Development Settings
NODE_ENV=development

# Optional: Redis for production caching
REDIS_URL=redis://localhost:6379

# Optional: Additional API Keys for enhanced data
COINGECKO_API_KEY=your-coingecko-pro-key
CRYPTOCOMPARE_API_KEY=your-cryptocompare-key
NEWSAPI_KEY=your-newsapi-key

# Security (Auto-generated in production)
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Additional optional keys referenced in the code
ALLOWED_ORIGIN=
ADMIN_IPS=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
COINMARKETCAP_API_KEY=
CRYPTONEWS_API_KEY=
NEWS_API_KEY=
YOUTUBE_API_KEY=
